{
  "name": "@best-i18n/next-unprefixed-locale",
  "version": "0.0.0",
  "description": "Serve the default locale unprefixed in a Next.js static export: mirrors app/[locale] into a route group that pins the locale",
  "keywords": [
    "app-router",
    "codegen",
    "default-locale",
    "i18n",
    "locale",
    "next",
    "nextjs",
    "static-export"
  ],
  "homepage": "https://github.com/best-i18n/next-unprefixed-locale#readme",
  "bugs": "https://github.com/best-i18n/next-unprefixed-locale/issues",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/best-i18n/next-unprefixed-locale.git"
  },
  "bin": {
    "next-unprefixed-locale": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "default": "./dist/runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "bumpp"
  },
  "dependencies": {
    "cac": "^7.0.0",
    "oxc-parser": "^0.149.0"
  },
  "devDependencies": {
    "@debbl/oxc-config": "^0.0.5",
    "@types/node": "^25.9.6",
    "@types/react": "^19.3.0",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "react": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4"
}
